--- !u!114 &1785853290
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1785853289}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b96ddc83c0f99c040bd718749c0e5098, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroStoryManager
  introPanel: {fileID: 1939468113}
  titleText: {fileID: 380017236}
  storyText: {fileID: 376255024}
  hintText: {fileID: 930898584}
  nextSceneName: SampleScene
  storyPages:
  - "N\u0103m 2034, m\u1ED9t lo\u1EA1i kho\xE1ng s\u1EA3n xanh t\xEDm \u0111\u01B0\u1EE3c
    t\xECm th\u1EA5y d\u01B0\u1EDBi m\u1ED9t khu m\u1ECF b\u1ECF hoang.\n\nNg\u01B0\u1EDDi
    ta g\u1ECDi n\xF3 l\xE0 Lumenite."
  - "Ban \u0111\u1EA7u, Lumenite \u0111\u01B0\u1EE3c xem l\xE0 ph\xE9p m\xE0u c\u1EE7a
    nh\xE2n lo\u1EA1i.\n\nN\xF3 c\xF3 th\u1EC3 ch\u1EEFa l\xE0nh nh\u1EEFng v\u1EBFt
    th\u01B0\u01A1ng kh\xF4ng th\u1EC3 ph\u1EE5c h\u1ED3i, t\xE1i t\u1EA1o t\u1EBF
    b\xE0o ch\u1EBFt, th\u1EADm ch\xED \u0111\xE1nh th\u1EE9c n\u0103ng l\u1EF1c
    v\u01B0\u1EE3t xa gi\u1EDBi h\u1EA1n con ng\u01B0\u1EDDi."
  - "Nh\u1EEFng ng\u01B0\u1EDDi \u0111\u01B0\u1EE3c ch\u1EEFa tr\u1ECB b\u1EB1ng
    n\xF3 \u0111\u01B0\u1EE3c g\u1ECDi l\xE0 The Ascended \u2014 Nh\u1EEFng K\u1EBB
    Th\u0103ng Hoa.\n\nNh\u01B0ng Lumenite kh\xF4ng th\u1EADt s\u1EF1 ch\u1EEFa l\xE0nh.\n\nN\xF3
    ch\u1EC9 \u0111ang chu\u1EA9n b\u1ECB v\u1EADt ch\u1EE7."
  - "Sau m\u1ED9t th\u1EDDi gian \u1EE7 b\u1EC7nh, nh\u1EEFng ng\u01B0\u1EDDi t\u1EEBng
    \u0111\u01B0\u1EE3c c\u1EE9u b\u1EAFt \u0111\u1EA7u nghe th\u1EA5y ti\u1EBFng
    th\xEC th\u1EA7m t\u1EEB \u0111\xE1.\n\nT\u1EEB c\xE1c v\u1EBFt th\u01B0\u01A1ng
    \u0111\xE3 l\xE0nh, tinh th\u1EC3 xanh t\xEDm m\u1ECDc xuy\xEAn qua da th\u1ECBt.
    X\u01B0\u01A1ng kh\u1EDBp bi\u1EBFn d\u1EA1ng. K\xFD \u1EE9c tan v\u1EE1. B\u1EA3n
    ng\xE3 b\u1ECB nu\u1ED1t d\u1EA7n."
  - "Nh\u1EEFng ng\u01B0\u1EDDi t\u1EEBng l\xE0 b\u1EC7nh nh\xE2n, b\xE1c s\u0129,
    c\xF4ng nh\xE2n v\xE0 si\xEAu nh\xE2n gi\u1EDD tr\u1EDF th\xE0nh nh\u1EEFng sinh
    v\u1EADt b\u1EA3o v\u1EC7 Lumenite b\u1EB1ng b\u1EA3n n\u0103ng.\n\nKhu \u0111i\u1EC1u
    tr\u1ECB b\u1ECB phong t\u1ECFa. H\u1EA7m m\u1ECF b\u1ECB b\u1ECF l\u1EA1i. Kh\xF4ng
    ai c\xF2n d\xE1m xu\u1ED1ng n\u01A1i m\u1ECDi th\u1EE9 b\u1EAFt \u0111\u1EA7u."
  - "B\u1EA1n t\u1EEBng l\xE0 m\u1ED9t b\u1EC7nh nh\xE2n trong ch\u01B0\u01A1ng tr\xECnh
    \u0111i\u1EC1u tr\u1ECB \u1EA5y.\n\nH\u1ED3 s\u01A1 ghi r\u1EB1ng b\u1EA1n kh\xF4ng
    c\xF2n kh\u1EA3 n\u0103ng s\u1ED1ng s\xF3t.\n\nNh\u01B0ng b\u1EA1n \u0111\xE3
    t\u1EC9nh l\u1EA1i."
  - "Trong l\u1ED3ng ng\u1EF1c b\u1EA1n xu\u1EA5t hi\u1EC7n m\u1ED9t v\u1EBFt n\u1EE9t
    ph\xE1t s\xE1ng h\xECnh d\u1EA5u g\u1EA1ch ch\xE9o.\n\nKhi nh\u1EEFng ng\u01B0\u1EDDi
    kh\xE1c m\u1EA5t tr\xED, b\u1EA1n v\u1EABn gi\u1EEF \u0111\u01B0\u1EE3c b\u1EA3n
    ng\xE3.\n\nKhi Lumenite c\u1ED1 nu\u1ED1t ch\u1EEDng c\u01A1 th\u1EC3 b\u1EA1n,
    n\xF3 b\u1ECB k\u1EB9t l\u1EA1i."
  - "B\u1EA1n l\xE0 v\u1EADt ch\u1EE7 l\u1ED7i.\n\nHo\u1EB7c l\xE0 ch\xECa kh\xF3a
    cu\u1ED1i c\xF9ng."
  - "Mu\u1ED1n bi\u1EBFt v\xEC sao m\xECnh ch\u01B0a bi\u1EBFn th\xE0nh qu\xE1i v\u1EADt,
    b\u1EA1n ph\u1EA3i quay l\u1EA1i n\u01A1i m\u1ECDi th\u1EE9 b\u1EAFt \u0111\u1EA7u.\n\nKhu
    \u0111i\u1EC1u tr\u1ECB b\u1ECF hoang.\n\nMi\u1EC7ng m\u1ECF c\u0169.\n\nN\u01A1i
    Lumenite v\u1EABn \u0111ang th\u1EDF."
  useTypewriterEffect: 1
  characterDelay: 0.035
